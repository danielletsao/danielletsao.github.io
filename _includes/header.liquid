<header>
  <style>
    .navbar .nav-force-container {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      width: 100%;
    }
    .navbar .nav-force-left {
      display: flex !important;
      align-items: center !important;
      gap: 1rem;
      flex: 0 0 auto !important;
    }
    .navbar .nav-force-right {
      display: flex !important;
      align-items: center !important;
      justify-content: flex-end !important;
      flex: 0 0 auto !important;
      width: auto !important;
    }
    .navbar .nav-force-right .navbar-nav {
      display: flex !important;
      flex-direction: row !important;
      gap: 1.5rem !important;
    }
    .navbar .nav-force-right .navbar-nav .nav-item,
    .navbar .nav-force-right .navbar-nav .toggle-container {
      margin: 0 !important;
      display: flex !important;
      align-items: center !important;
    }
    .navbar .toggle-container #light-toggle {
      display: flex !important;
      align-items: center !important;
      line-height: 1 !important;
      vertical-align: middle !important;
    }
    .navbar .toggle-container #light-toggle i {
      vertical-align: middle !important;
      line-height: 1 !important;
      transform: translateY(-3px);
      position: relative;
    }
    @media (min-width: 576px) {
      .navbar .navbar-toggler {
        display: none !important;
      }
    }
    @media (max-width: 575.98px) {
      .navbar .nav-force-container {
        flex-wrap: wrap;
      }
      .navbar .nav-force-right {
        display: none !important;
        width: 100% !important;
        justify-content: flex-start !important;
      }
      .navbar .nav-force-right {
        display: none !important;
      }
    }

    /* Fresh, isolated mobile menu overlay - no dependency on Bootstrap collapse classes */
    #mobile-nav-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: var(--global-bg-color, #fff);
      z-index: 99999;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
    }
    #mobile-nav-overlay.mobile-menu-open {
      display: flex !important;
    }
    #mobile-nav-overlay a {
      font-size: 1.4rem;
      color: var(--global-text-color, #000);
      text-decoration: none;
    }
    #mobile-nav-overlay-close {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      font-size: 2rem;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--global-text-color, #000);
    }
    body.mobile-menu-locked {
      overflow: hidden;
    }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var toggler = document.querySelector('.navbar-toggler');
      var overlay = document.getElementById('mobile-nav-overlay');
      var closeBtn = document.getElementById('mobile-nav-overlay-close');

      function openMenu() {
        overlay.classList.add('mobile-menu-open');
        document.body.classList.add('mobile-menu-locked');
        toggler.setAttribute('aria-expanded', 'true');
        toggler.classList.remove('collapsed');
      }
      function closeMenu() {
        overlay.classList.remove('mobile-menu-open');
        document.body.classList.remove('mobile-menu-locked');
        toggler.setAttribute('aria-expanded', 'false');
        toggler.classList.add('collapsed');
      }

      if (toggler && overlay) {
        toggler.addEventListener('click', function () {
          if (overlay.classList.contains('mobile-menu-open')) {
            closeMenu();
          } else {
            openMenu();
          }
        });
      }
      if (closeBtn) {
        closeBtn.addEventListener('click', closeMenu);
      }
      // Close menu when a link inside it is tapped
      if (overlay) {
        overlay.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', closeMenu);
        });
      }
    });
  </script>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container nav-force-container">
      <div class="nav-force-left">
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
        {% if site.enable_navbar_social %}
          <!-- Social Icons -->
          <div class="navbar-brand social">{% include social.liquid %}</div>
        {% endif %}
      </div>

      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed sm:hidden"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse nav-force-right" id="navbarNav">
        <ul class="navbar-nav flex flex-row items-center flex-nowrap gap-1">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a class="dropdown-item {% if page.title == child.title %}active{% endif %}" href="{{ child.permalink | relative_url }}">
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                <li class="nav-item {% if page.url contains p.permalink %}active{% endif %}">
                  {% if p.permalink contains '/blog/' %}{% assign url = '/blog/' %} {% else %}{% assign url = p.url %}{% endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="fa-solid fa-moon"></i>
                <i class="fa-solid fa-sun"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>

  <!-- Fresh, isolated mobile nav overlay -->
  <div id="mobile-nav-overlay">
    <button id="mobile-nav-overlay-close" aria-label="Close menu">&times;</button>
    <a href="{{ '/' | relative_url }}">{{ about_title }}</a>
    {% assign sorted_pages = site.pages | sort: 'nav_order' %}
    {% for p in sorted_pages %}
      {% if p.nav and p.autogen == null and p.dropdown == null %}
        {% if p.permalink contains '/blog/' %}
          {% assign mobile_url = '/blog/' %}
        {% else %}
          {% assign mobile_url = p.url %}
        {% endif %}
        <a href="{{ mobile_url | relative_url }}">{{ p.title }}</a>
      {% endif %}
    {% endfor %}
  </div>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>

<header>
  <style>
    .navbar .nav-link {
      text-transform: capitalize;
    }
    .navbar .nav-force-container {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      width: 100%;
    }
    .navbar .nav-force-left {
      display: flex !important;
      align-items: center !important;
      gap: 1rem;
      flex: 0 0 auto !important;
    }
    .navbar .nav-force-right {
      display: flex !important;
      align-items: center !important;
      justify-content: flex-end !important;
      flex: 0 0 auto !important;
      width: auto !important;
    }
    .navbar .nav-force-right .navbar-nav {
      display: flex !important;
      flex-direction: row !important;
      gap: 1.5rem !important;
    }
    .navbar .nav-force-right .navbar-nav .nav-item,
    .navbar .nav-force-right .navbar-nav .toggle-container {
      margin: 0 !important;
      display: flex !important;
      align-items: center !important;
    }
    .navbar .toggle-container #light-toggle {
      display: flex !important;
      align-items: center !important;
      line-height: 1 !important;
      vertical-align: middle !important;
    }
    .navbar .toggle-container #light-toggle i {
      vertical-align: middle !important;
      line-height: 1 !important;
      transform: translateY(-4px);
      position: relative;
    }
    @media (min-width: 576px) {
      .navbar .navbar-toggler {
        display: none !important;
      }
    }
    @media (max-width: 575.98px) {
      .navbar .nav-force-container {
        flex-wrap: wrap;
      }
      .navbar .nav-force-right {
        width: 100% !important;
        justify-content: flex-start !important;
      }
    }
  </style>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container nav-force-container">
      <div class="nav-force-left">
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
        {% if site.enable_navbar_social %}
          <!-- Social Icons -->
          <div class="navbar-brand social">{% include social.liquid %}</div>
        {% endif %}
      </div>

      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed sm:hidden"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse nav-force-right" id="navbarNav">
        <ul class="navbar-nav flex flex-row items-center flex-nowrap gap-1">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a class="dropdown-item {% if page.title == child.title %}active{% endif %}" href="{{ child.permalink | relative_url }}">
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                <li class="nav-item {% if page.url contains p.permalink %}active{% endif %}">
                  {% if p.permalink contains '/blog/' %}{% assign url = '/blog/' %} {% else %}{% assign url = p.url %}{% endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="fa-solid fa-moon"></i>
                <i class="fa-solid fa-sun"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
